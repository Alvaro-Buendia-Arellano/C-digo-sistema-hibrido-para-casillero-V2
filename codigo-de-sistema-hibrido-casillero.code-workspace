/*
 * PROYECTO: Casillero Inteligente (Sistema Híbrido)
 * HARDWARE: ESP32, Lector Huella AS608, RFID MFRC522, LCD I2C 16x2, Teclado 4x4, Relé 1 Canal, Buzzer.
 * ACTUADOR: Cerradura Eléctrica Dahua DHI-ASF601A (Fail-Secure)
 */

// ==============================================================================
// 1. INCLUSIÓN DE LIBRERÍAS
// ==============================================================================
#include <WiFi.h>                   // Conectividad Wi-Fi
#include <WebServer.h>              // Creación del servidor web integrado
#include <SPI.h>                    // Protocolo SPI para el lector RFID
#include <MFRC522.h>                // Control del lector de tarjetas RFID/NFC
#include <HardwareSerial.h>         // Comunicación serial por hardware (UART)
#include <Adafruit_Fingerprint.h>   // Control del sensor biométrico (AS608/R307)
#include <Wire.h>                   // Protocolo I2C para la pantalla
#include <LiquidCrystal_I2C.h>      // Control de la Pantalla LCD 16x2
#include <Keypad.h>                 // Control del Teclado Matricial 4x4

// ==============================================================================
// 2. CREDENCIALES DE RED Y ADMINISTRACIÓN WEB
// ==============================================================================
const char* ssid = "TU_RED_WIFI";
const char* password = "TU_CONTRASENA_WIFI";

// Credenciales para que el personal institucional acceda a la página
const char* adminUser = "admin_uttec";
const char* adminPass = "Acceso2026"; 

WebServer server(80); // Inicia el servidor en el puerto 80 (HTTP estándar)

// ==============================================================================
// 3. ASIGNACIÓN ESTRICTA DE PINES (GPIO DEL ESP32)
// ==============================================================================
// Actuadores y Alertas
#define RELAY_PIN 15    // Control del Módulo Relevador (Activa la cerradura Dahua)
#define BUZZER_PIN 4    // Control del Zumbador (Alertas sonoras)

// Pines MFRC522 (RFID) - Bus VSPI
#define SS_PIN 5        // Pin SDA (Select)
#define RST_PIN 2       // Pin de Reset
// Nota: SCK=18, MISO=19, MOSI=23 (Pines SPI por defecto del ESP32, no se declaran)

// Pines Pantalla LCD I2C
// Nota: SDA=21, SCL=22 (Pines I2C por defecto, manejados por la librería Wire)

// Pines Lector Biométrico (UART2)
#define FINGER_RX 16    // Recibe datos del sensor (cable verde/blanco)
#define FINGER_TX 17    // Transmite datos al sensor (cable amarillo/azul)

// Pines Teclado Matricial 4x4
const byte FILAS = 4;
const byte COLUMNAS = 4;
byte pinesFilas[FILAS] = {13, 12, 14, 27};    // R1, R2, R3, R4
byte pinesColumnas[COLUMNAS] = {26, 25, 33, 32}; // C1, C2, C3, C4
char teclas[FILAS][COLUMNAS] = {
  {'1','2','3','A'},
  {'4','5','6','B'},
  {'7','8','9','C'},
  {'*','0','#','D'}
};
String pinIngresado = "";       // Variable para guardar el PIN tipeado
const String PIN_SECRETO = "1234"; // PIN maestro/usuario (ejemplo)

// ==============================================================================
// 4. INICIALIZACIÓN DE OBJETOS
// ==============================================================================
MFRC522 rfid(SS_PIN, RST_PIN);
HardwareSerial mySerial(2); 
Adafruit_Fingerprint finger = Adafruit_Fingerprint(&mySerial);
LiquidCrystal_I2C lcd(0x27, 16, 2); // Dirección I2C común (puede ser 0x3F)
Keypad teclado = Keypad(makeKeymap(teclas), pinesFilas, pinesColumnas, FILAS, COLUMNAS);

// ==============================================================================
// 5. FUNCIONES DE CONTROL DE HARDWARE (INTERFAZ Y ACTUADORES)
// ==============================================================================

// Función que abre la cerradura e informa al usuario
void concederAcceso(String metodo) {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Acceso Autorizado");
  lcd.setCursor(0, 1);
  lcd.print("Por: " + metodo);
  
  // Activa relevador para energizar la contra-chapa Dahua DHI-ASF601A
  digitalWrite(RELAY_PIN, HIGH); 
  
  // Tono de éxito
  digitalWrite(BUZZER_PIN, HIGH); delay(100); digitalWrite(BUZZER_PIN, LOW); delay(50);
  digitalWrite(BUZZER_PIN, HIGH); delay(100); digitalWrite(BUZZER_PIN, LOW);
  
  delay(4000); // 4 Segundos para que el usuario jale la puerta
  
  // Bloqueo automático (Corta energía al relevador)
  digitalWrite(RELAY_PIN, LOW); 
  
  // Restablece la pantalla principal
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Casillero UTTEC");
  lcd.setCursor(0, 1);
  lcd.print("Esperando...");
}

// Función para denegar acceso ante credenciales incorrectas
void denegarAcceso() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Acceso Denegado");
  lcd.setCursor(0, 1);
  lcd.print("Intente de nuevo");
  
  digitalWrite(BUZZER_PIN, HIGH); delay(1000); digitalWrite(BUZZER_PIN, LOW);
  
  delay(2000);
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Casillero UTTEC");
  lcd.setCursor(0, 1);
  lcd.print("Esperando...");
}

// ==============================================================================
// 6. FUNCIONES DEL SERVIDOR WEB (GESTIÓN INSTITUCIONAL)
// ==============================================================================

void paginaPrincipal() {
  // Solicita Usuario y Contraseña institucionales antes de mostrar la página
  if (!server.authenticate(adminUser, adminPass)) {
    return server.requestAuthentication();
  }
  
  // Diseño de la interfaz web en HTML y CSS
  String html = "<!DOCTYPE html><html><head><meta charset='UTF-8'><title>Admin - UTTEC</title>";
  html += "<style>body{font-family:Arial; text-align:center; padding:30px; background:#e9ecef;}";
  html += ".caja{background:white; padding:20px; border-radius:10px; display:inline-block;}";
  html += "button{background:#0056b3; color:white; padding:10px 20px; border:none; border-radius:5px; cursor:pointer;}";
  html += "input{padding:10px; margin-bottom:10px; width:200px;}</style></head><body>";
  html += "<div class='caja'><h2>Gestión de Accesos a Casilleros</h2>";
  
  // Botón para enrolar huella
  html += "<form action='/agregar' method='GET'><button type='submit'>Agregar Huella/Tarjeta</button></form><br>";
  
  // Formulario para dar de baja un registro
  html += "<form action='/eliminar' method='GET'>";
  html += "<input type='number' name='id_alumno' placeholder='ID de Registro a Borrar' required><br>";
  html += "<button type='submit' style='background:#dc3545;'>Eliminar Permiso</button></form>";
  html += "</div></body></html>";
  
  server.send(200, "text/html", html);
}

// Lógica web para enrolar
void agregarRegistro() {
  if (!server.authenticate(adminUser, adminPass)) return server.requestAuthentication();
  server.send(200, "text/plain", "Modo Registro Activado. Coloque su huella en el sensor fisico.");
  // (Aquí se llama a la rutina interna de la librería de huellas para guardar el modelo)
}

// Lógica web para eliminar
void eliminarRegistro() {
  if (!server.authenticate(adminUser, adminPass)) return server.requestAuthentication();
  if (server.hasArg("id_alumno")) {
    int id = server.arg("id_alumno").toInt();
    finger.deleteModel(id); // Borra la huella de la memoria del sensor
    server.send(200, "text/plain", "Registro borrado exitosamente. ID: " + String(id));
  }
}

// ==============================================================================
// 7. CONFIGURACIÓN INICIAL (SETUP)
// ==============================================================================
void setup() {
  Serial.begin(115200);
  
  // Configuración de Pines de Salida
  pinMode(RELAY_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, LOW); // La chapa Dahua debe iniciar bloqueada
  
  // Inicialización de Pantalla LCD
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0,0);
  lcd.print("Iniciando...");
  
  // Inicialización de Módulo RFID (SPI)
  SPI.begin();
  rfid.PCD_Init();
  
  // Inicialización de Lector Biométrico (UART)
  finger.begin(57600);
  if (finger.verifyPassword()) {
    lcd.setCursor(0,1); lcd.print("Sensor OK");
  } else {
    lcd.setCursor(0,1); lcd.print("Error Biometria");
  }
  delay(1500);
  
  // Conexión Wi-Fi
  lcd.clear();
  lcd.print("Conectando WiFi");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
  }
  lcd.clear();
  lcd.setCursor(0,0); lcd.print("WiFi OK");
  lcd.setCursor(0,1); lcd.print(WiFi.localIP().toString()); // Muestra IP para entrar a la Web
  delay(3000);
  
  // Arranque del Servidor Web
  server.on("/", paginaPrincipal);
  server.on("/agregar", agregarRegistro);
  server.on("/eliminar", eliminarRegistro);
  server.begin();
  
  // Estado de Reposo
  lcd.clear();
  lcd.setCursor(0,0); lcd.print("Casillero UTTEC");
  lcd.setCursor(0,1); lcd.print("Esperando...");
}

// ==============================================================================
// 8. BUCLE PRINCIPAL (LOOP)
// ==============================================================================
void loop() {
  server.handleClient(); // Atiende peticiones del administrador en la página web
  
  // ---------------------------------------------------------
  // VALIDACIÓN 1: TARJETA RFID / NFC
  // ---------------------------------------------------------
  if (rfid.PICC_IsNewCardPresent() && rfid.PICC_ReadCardSerial()) {
    // Aquí se compara el UID de la tarjeta con los registrados.
    // Si la lectura es exitosa:
    concederAcceso("Tarjeta RFID");
    rfid.PICC_HaltA(); // Pausa el lector temporalmente
  }
  
  // ---------------------------------------------------------
  // VALIDACIÓN 2: HUELLA DACTILAR
  // ---------------------------------------------------------
  if (finger.getImage() == FINGERPRINT_OK) {
    if (finger.image2Tz() == FINGERPRINT_OK) {
      if (finger.fingerSearch() == FINGERPRINT_OK) {
        concederAcceso("Huella Digital");
      } else {
        denegarAcceso();
      }
    }
  }
  
  // ---------------------------------------------------------
  // VALIDACIÓN 3: TECLADO MATRICIAL (PIN)
  // ---------------------------------------------------------
  char tecla = teclado.getKey();
  if (tecla) {
    if (tecla == '#') { // Tecla de "Aceptar"
      if (pinIngresado == PIN_SECRETO) {
        concederAcceso("Clave PIN");
      } else {
        denegarAcceso();
      }
      pinIngresado = ""; // Limpia la variable tras evaluar
    } 
    else if (tecla == '*') { // Tecla de "Borrar"
      pinIngresado = "";
      lcd.setCursor(0, 1); lcd.print("Borrado...      ");
      delay(500);
      lcd.setCursor(0, 1); lcd.print("Esperando...    ");
    } 
    else { // Agrega números a la cadena
      pinIngresado += tecla;
      lcd.setCursor(0, 1);
      lcd.print("PIN: ");
      // Muestra asteriscos en la pantalla por seguridad
      for (int i=0; i<pinIngresado.length(); i++){ lcd.print("*"); }
    }
  }
}